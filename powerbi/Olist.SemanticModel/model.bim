            "name": "delivery_bucket_sort",
            "dataType": "int64",
            "lineageTag": "e5ad71f0-faac-486c-b148-5148e0dd9784",
            "sourceColumn": "delivery_bucket_sort",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "a39c8c24-30bd-42d5-99df-0c62c091ef7f",
        "measures": [
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1 )",
            "formatString": "#,0",
            "lineageTag": "e36e7179-408b-4eb2-beaa-74b58137d9cc"
          },
          {
            "name": "Total Revenue",
            "expression": "CALCULATE ( SUM ( fact_orders[revenue] ), fact_orders[is_delivered] = 1 )",
            "formatString": "\"R$ \"#,0",
            "lineageTag": "95739ad5-426c-4fac-be30-6d6292f28fdd"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE ( [Total Revenue], [Delivered Orders] )",
            "formatString": "\"R$ \"#,0.00",
            "lineageTag": "50fd14f0-c6b6-40d4-8179-a692c8663c9e"
          },
          {
            "name": "Customers",
            "expression": "CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_unique_id] ), fact_orders[is_delivered] = 1 )",
            "formatString": "#,0",
            "lineageTag": "d077886b-bc67-41ca-b281-965380f18068"
          },
          {
            "name": "Revenue Prev Month",
            "expression": "CALCULATE ( [Total Revenue], DATEADD ( dim_date[date], -1, MONTH ) )",
            "formatString": "\"R$ \"#,0",
            "lineageTag": "a24eec78-e5ab-47a3-8acd-6c98d29649fd"
          },
          {
            "name": "Revenue MoM %",
            "expression": "DIVIDE ( [Total Revenue] - [Revenue Prev Month], [Revenue Prev Month] )",
            "formatString": "0.0%",
            "lineageTag": "744b9250-7f5a-494f-9724-8b4f1bef19d9"
          },
          {
            "name": "Category Revenue",
            "expression": "CALCULATE ( SUM ( fact_order_items[price] ), fact_orders[is_delivered] = 1 )",
            "formatString": "\"R$ \"#,0",
            "lineageTag": "afd68ab5-b756-40e8-866a-3dbc8f5b4056"
          },
          {
            "name": "Avg Delivery Days",
            "expression": "CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_delivered] = 1 )",
            "formatString": "#,0.0",
            "lineageTag": "f935bb72-82e5-4b3d-8e25-105fc651179f"
          },
          {
            "name": "Late Delivery %",
            "expression": "CALCULATE ( AVERAGE ( fact_orders[is_late] ), fact_orders[is_delivered] = 1 )",
            "formatString": "0.0%",
            "lineageTag": "a7acc0c8-9e97-4e11-9351-5e622ac58610"
          },
          {
            "name": "Avg Review",
            "expression": "CALCULATE ( AVERAGE ( fact_orders[review_score] ), fact_orders[is_delivered] = 1 )",
            "formatString": "#,0.00",
            "lineageTag": "71f80927-a7e9-4e56-aee3-f849305cd013"
          },
          {
            "name": "Bad Review %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1,",
              "        NOT ISBLANK ( fact_orders[review_score] ), fact_orders[review_score] <= 2 ),",
              "    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1, NOT ISBLANK ( fact_orders[review_score] ) )",
              ")"
            ],
            "formatString": "0.0%",
            "lineageTag": "59ed57b4-8fd0-4676-a00f-bfd7cb11ec55"
          },
          {
            "name": "Repeat Customer %",
            "expression": [
              "VAR cust =",
              "    CALCULATETABLE (",
              "        SUMMARIZE ( fact_orders, fact_orders[customer_unique_id], \"n\", COUNTROWS ( fact_orders ) ),",
              "        fact_orders[is_delivered] = 1",
              "    )",
              "RETURN",
              "    DIVIDE ( COUNTROWS ( FILTER ( cust, [n] > 1 ) ), COUNTROWS ( cust ) )"
            ],
            "formatString": "0.0%",
            "lineageTag": "431d74d3-7036-4688-af20-073f6ea44000"
          },
          {
            "name": "Segment Customers",
            "expression": "[Customers]",
            "formatString": "#,0",
            "lineageTag": "eaa3d214-b2d0-4dcc-b9ae-9834a4269a68"
          },
          {
            "name": "Segment Revenue Share",
            "expression": "DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALL ( dim_customer[segment] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "4dc40e33-5f7e-47ed-a00f-0150fca87eee"
          }
        ],
        "partitions": [
