        "isActive": true
      },
      {
        "name": "OrderCustomer",
        "fromTable": "fact_orders",
        "fromColumn": "customer_unique_id",
        "toTable": "dim_customer",
        "toColumn": "customer_unique_id",
        "fromCardinality": "many",
