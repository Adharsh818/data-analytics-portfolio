{
  "name": "Olist",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "fact_orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_unique_id",
            "dataType": "string",
            "sourceColumn": "customer_unique_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_state",
            "dataType": "string",
            "sourceColumn": "customer_state",
            "summarizeBy": "none"
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "purchase_date",
            "dataType": "dateTime",
            "sourceColumn": "purchase_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "n_items",
            "dataType": "int64",
            "sourceColumn": "n_items",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "none"
          },
          {
            "name": "freight",
            "dataType": "double",
            "sourceColumn": "freight",
            "summarizeBy": "none"
          },
          {
            "name": "payment_type",
            "dataType": "string",
            "sourceColumn": "payment_type",
            "summarizeBy": "none"
          },
          {
            "name": "installments",
            "dataType": "int64",
            "sourceColumn": "installments",
            "summarizeBy": "none"
          },
          {
            "name": "review_score",
            "dataType": "double",
            "sourceColumn": "review_score",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_days",
            "dataType": "double",
            "sourceColumn": "delivery_days",
            "summarizeBy": "none"
          },
          {
            "name": "days_vs_estimate",
            "dataType": "double",
            "sourceColumn": "days_vs_estimate",
            "summarizeBy": "none"
          },
          {
            "name": "is_late",
            "dataType": "int64",
            "sourceColumn": "is_late",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_bucket",
            "dataType": "string",
            "sourceColumn": "delivery_bucket",
            "summarizeBy": "none",
            "sortByColumn": "delivery_bucket_sort"
          },
          {
            "name": "is_delivered",
            "dataType": "int64",
            "sourceColumn": "is_delivered",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_bucket_sort",
            "dataType": "int64",
            "sourceColumn": "delivery_bucket_sort",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_orders.csv\"),",
                "        [Delimiter=\",\", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Blanks = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"order_id\", type text}, {\"customer_unique_id\", type text}, {\"customer_state\", type text}, {\"order_status\", type text}, {\"purchase_date\", type date}, {\"n_items\", Int64.Type}, {\"revenue\", type number}, {\"freight\", type number}, {\"payment_type\", type text}, {\"installments\", Int64.Type}, {\"review_score\", type number}, {\"delivery_days\", type number}, {\"days_vs_estimate\", type number}, {\"is_late\", Int64.Type}, {\"delivery_bucket\", type text}, {\"is_delivered\", Int64.Type}, {\"delivery_bucket_sort\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Delivered Orders",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Total Revenue",
            "expression": [
              "CALCULATE ( SUM ( fact_orders[revenue] ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "\"R$ \"#,0"
          },
          {
            "name": "Avg Order Value",
            "expression": [
              "DIVIDE ( [Total Revenue], [Delivered Orders] )"
            ],
            "formatString": "\"R$ \"#,0.00"
          },
          {
            "name": "Customers",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_unique_id] ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Revenue Prev Month",
            "expression": [
              "CALCULATE ( [Total Revenue], DATEADD ( dim_date[date], -1, MONTH ) )"
            ],
            "formatString": "\"R$ \"#,0"
          },
          {
            "name": "Revenue MoM %",
            "expression": [
              "DIVIDE ( [Total Revenue] - [Revenue Prev Month], [Revenue Prev Month] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Category Revenue",
            "expression": [
              "CALCULATE ( SUM ( fact_order_items[price] ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "\"R$ \"#,0"
          },
          {
            "name": "Avg Delivery Days",
            "expression": [
              "CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "Late Delivery %",
            "expression": [
              "CALCULATE ( AVERAGE ( fact_orders[is_late] ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Avg Review",
            "expression": [
              "CALCULATE ( AVERAGE ( fact_orders[review_score] ), fact_orders[is_delivered] = 1 )"
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "Bad Review %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1,",
              "        NOT ISBLANK ( fact_orders[review_score] ), fact_orders[review_score] <= 2 ),",
              "    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1, NOT ISBLANK ( fact_orders[review_score] ) )",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Repeat Customer %",
            "expression": [
              "VAR cust =",
              "    CALCULATETABLE (",
              "        SUMMARIZE ( fact_orders, fact_orders[customer_unique_id], \"n\", COUNTROWS ( fact_orders ) ),",
              "        fact_orders[is_delivered] = 1",
              "    )",
              "RETURN",
              "    DIVIDE ( COUNTROWS ( FILTER ( cust, [n] > 1 ) ), COUNTROWS ( cust ) )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Segment Customers",
            "expression": [
              "[Customers]"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Segment Revenue Share",
            "expression": [
              "DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALL ( dim_customer[segment] ) ) )"
            ],
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "fact_order_items",
        "columns": [
          {
            "name": "order_id",
